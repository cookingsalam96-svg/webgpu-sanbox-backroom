{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HARDAM Entity Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "type", "value", "timestamp", "confidence", "measurement_quality", "data_kind", "provenance"],
  "properties": {
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "type": {"type": "string", "minLength": 1, "maxLength": 64},
    "value": {},
    "unit": {"type": ["string", "null"], "maxLength": 32},
    "timestamp": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "measurement_quality": {"type": "string", "enum": ["valid", "degraded", "missing", "simulated", "unknown"]},
    "data_kind": {"type": "string", "enum": ["hardware", "simulation", "user_supplied", "derived"]},
    "provenance": {"type": ["string", "null"], "maxLength": 512}
  }
}
